# EventHub Environment Configuration
# Add your environment variables here and copy to .env

# Server Port
PORT=3000

# ==============================================================================
# EMAIL NOTIFICATIONS (Gmail SMTP)
# ------------------------------------------------------------------------------
# 1. Enable 2-Step Verification in your Google Account.
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an App Password for "EventHub", generate a 16-character code.
# 4. Paste your email and generated App Password below:
# ==============================================================================
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-16-char-app-password"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465

# ==============================================================================
# SMS NOTIFICATIONS (Twilio or Fast2SMS)
# ------------------------------------------------------------------------------
# Option A: Twilio (Global SMS)
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="your_twilio_auth_token"
# TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"
#
# Option B: Fast2SMS (India Quick SMS)
# FAST2SMS_API_KEY="your_fast2sms_api_key"
# ==============================================================================
FAST2SMS_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Firebase Configuration
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="event-hub-36864.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="event-hub-36864"
VITE_FIREBASE_STORAGE_BUCKET="event-hub-36864.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="260968384601"
VITE_FIREBASE_APP_ID="1:260968384601:web:3d825f81f8f3d6351ec948"

